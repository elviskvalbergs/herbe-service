# Live ERP contract test env contract (tests/live/erp-contract.test.ts).
# Copy the values you need into a worktree-local `.env.vars` (git-ignored,
# never committed) — the test loads that file itself, no shell export needed.
# Run with `pnpm test:live`. Never commit real values here or in `.env.vars`.

RUN_LIVE_ERP_TESTS=      # set to 1 to un-skip the live suite; unset/empty = skipped everywhere else
ERP_BASE_URL=            # dedicated test-ERP base URL, e.g. https://test-erp.example.com
ERP_COMPANY_NUMBER=      # test-ERP company number
ERP_USER=                # test-ERP REST API username
ERP_PASSWORD=            # test-ERP REST API password

# MASTER_ENCRYPTION_KEY is reused from the app env (see lib/security/envelope.ts) —
# not redefined here. The live test falls back to a throwaway key if unset.
